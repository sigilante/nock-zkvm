/-! ## the check -/

/-- list-recursive (linear in the kernel; `a[i]!` on an `Array` is not) -/
def exListEqB : List Ex → List Ex → Bool
  | [], [] => true
  | a :: as, b :: bs => exEqB a b && exListEqB as bs
  | _, _ => false

def exArrEqB (a b : Array Ex) : Bool := exListEqB a.toList b.toList

def conEqB (a b : Con) : Bool := a.kind == b.kind && a.round == b.round && a.deg == b.deg && exEqB a.e b.e

def conListEqB : List Con → List Con → Bool
  | [], [] => true
  | a :: as, b :: bs => conEqB a b && conListEqB as bs
  | _, _ => false

def chipEqB (a b : Chip) : Bool :=
  a.id == b.id && exArrEqB a.shared b.shared && conListEqB a.cons.toList b.cons.toList &&
  a.colRound == b.colRound && a.baseCols == b.baseCols && a.width == b.width

/-- `(numeral, expected verifier chip)` for a chip id (numeral = kroots / krootsV for the walk chips, `0` otherwise) -/
def expectedOf (id : String) : List (Nat × Chip) :=
  if id == "computeChipVCLHX" then [(0, chipCompute)]
  else if id == "cellChipHQKW" then [(0, chipCell)]
  else if id == "atomChipHQL" then [(0, chipAtom)]
  else if id == "jetChipJ8" then [(0, chipJet)]
  else if id == "walkChipJ8" then
    [(1, chipWalkJ8_1), (9, chipWalkJ8_9), (25, chipWalkJ8_25), (42, chipWalkJ8_42), (48, chipWalkJ8_48), (174, chipWalkJ8_174)]
  else if id == "walkChipHQK" then [(1, chipWalkHQK_1), (2, chipWalkHQK_2)]
  else []

/-- the numeral of the literal the chip equals (`none`: no literal of its id matches) -/
def chipNumeral (c : Chip) : Option Nat := ((expectedOf c.id).find? fun p => chipEqB c p.2).map (·.1)

def chipsOk (X : V.ExecInst) : Bool := X.tabs.all fun t => (chipNumeral t.chip).isSome

end NockvmE2E.Exec.J8Chips
