namespace Nock.V1J8.J8CheckMain

open Nock.TraceGenExe Nock.V1J8.Exe Nock.V1J8.Check Nock.V1J8.Example

structure Opts where
  coins : Option String := none
  inDir : Option String := none
  dump : Option String := none
  tamper : Bool := false
  fast : Bool := false
  prog : Option String := none

def parseOpts : List String → Opts → Except String Opts
  | [], o => .ok o
  | "--coins" :: v :: r, o => parseOpts r { o with coins := some v }
  | "--in" :: v :: r, o => parseOpts r { o with inDir := some v }
  | "--dump" :: v :: r, o => parseOpts r { o with dump := some v }
  | "--tamper" :: r, o => parseOpts r { o with tamper := true }
  | "--fast" :: r, o => parseOpts r { o with fast := true }
  | "--prog" :: v :: r, o => parseOpts r { o with prog := some v }
  | a :: _, _ => .error s!"unknown or incomplete argument: {a}"

def words (s : String) : List String :=
  ((s.map fun c => if c.isWhitespace then ' ' else c).splitOn " ").filter (· ≠ "")

def parseNat (w : String) : Except String ℕ :=
  match w.toNat? with
  | some n => if n < Nock.Field.p then .ok n else .error s!"value {w} is not below p"
  | none => .error s!"not a number: {w}"

def gOf (n : ℕ) : Gold := natG n

def readCoins (f : System.FilePath) : ExceptT String IO CoinsE := do
  let s ← (IO.FS.readFile f : IO String)
  let ws := words s
  if ws.length ≠ 60 then throw s!"{f}: expected 60 numbers (20 coins x 3 limbs), found {ws.length}"
  let ns ← ws.mapM fun w => (ExceptT.mk (pure (parseNat w)) : ExceptT String IO ℕ)
  let a := ns.toArray
  pure fun i => ⟨gOf a[3 * (i : ℕ)]!, gOf a[3 * (i : ℕ) + 1]!, gOf a[3 * (i : ℕ) + 2]!⟩

def readRows (f : System.FilePath) (n : ℕ) : ExceptT String IO (ℕ → Fin n → ZMod Nock.Field.p) := do
  let s ← (IO.FS.readFile f : IO String)
  let ls := (s.splitOn "\n").filter fun l => (words l) ≠ []
  if ls.length ≠ n then throw s!"{f}: expected {n} rows, found {ls.length}"
  let rows ← ls.mapM fun l => (words l).mapM fun w => (ExceptT.mk (pure (parseNat w)) : ExceptT String IO ℕ)
  let a : Array (Array ℕ) := (rows.map List.toArray).toArray
  pure fun c i => (((a[(i : ℕ)]!)[c]?.getD 0 : ℕ) : ZMod Nock.Field.p)

/-- The six chips: file name, width, accessor. -/
def chips : List (String × ℕ) :=
  [("compute.rows", 123), ("cell.rows", 242), ("walk.rows", 166), ("atom.rows", 349), ("aw.rows", 166)]

def chipOf (I : InJ8) : String → ChipIn
  | "compute.rows" => I.X | "cell.rows" => I.C | "walk.rows" => I.W | "atom.rows" => I.A
  | _ => I.V

def writeRows (f : System.FilePath) (q : ChipIn) (w : ℕ) : IO Unit := do
  let lines := (List.finRange q.n).map fun i =>
    " ".intercalate ((List.range w).map fun c => toString (q.cols c i).val)
  IO.FS.writeFile f ("\n".intercalate lines ++ "\n")

def replace (I : InJ8) (dir : System.FilePath) : ExceptT String IO InJ8 := do
  let mut J := I
  if ← (dir / "compute.rows").pathExists then
    let r ← readRows (dir / "compute.rows") I.X.n; J := { J with X := { I.X with cols := r } }
  if ← (dir / "cell.rows").pathExists then
    let r ← readRows (dir / "cell.rows") I.C.n; J := { J with C := { I.C with cols := r } }
  if ← (dir / "walk.rows").pathExists then
    let r ← readRows (dir / "walk.rows") I.W.n; J := { J with W := { I.W with cols := r } }
  if ← (dir / "atom.rows").pathExists then
    let r ← readRows (dir / "atom.rows") I.A.n; J := { J with A := { I.A with cols := r } }
  if ← (dir / "aw.rows").pathExists then
    let r ← readRows (dir / "aw.rows") I.V.n; J := { J with V := { I.V with cols := r } }
  pure J

def verdict (b : Bool) : String := if b then "pass" else "FAIL"

/-- Limbs (low first, base `B = 2^32`) to a number. -/
def ofLimbs (l : List ℕ) : ℕ := l.foldr (fun x acc => x + 2 ^ 32 * acc) 0

def nA (n : ℕ) : Nock.Noun := .atom n
def nC (a b : Nock.Noun) : Nock.Noun := .cell a b
/-- `[0 ax]`, `[3 x]`, `[4 x]`, `[5 x y]`. -/
def ax (a : ℕ) : Nock.Noun := nC (nA 0) (nA a)
def op3 (x : Nock.Noun) : Nock.Noun := nC (nA 3) x
def op4 (x : Nock.Noun) : Nock.Noun := nC (nA 4) x
def op5 (x y : Nock.Noun) : Nock.Noun := nC (nA 5) (nC x y)

/-- **The multi-limb programs** (subject, formula, description); `Bm = B − 1`. -/
def mlProg (nm : String) : Option (Nock.Noun × Nock.Noun × String) :=
  let Bm := 2 ^ 32 - 1
  let P := Nock.Field.p
  if nm = "ovf" then
    -- [2^64-1 0], [3 [4 [4 [0 2]]]]: 2^64-1 = [Bm Bm] -> 2^64 = [0 0 1] (top-limb OVERFLOW into a new limb: the
    -- row [0 1] at idx+1) -> 2^64+1 = [1 0 1] (an inc row stopping at the root, its suffix the row [0 1])
    some (nC (nA (ofLimbs [Bm, Bm])) (nA 0), op3 (op4 (op4 (ax 2))),
      "*[[2^64-1 0] [3 [4 [4 [0 2]]]]] (top-limb overflow [Bm Bm] -> [0 0 1] -> [1 0 1])")
  else if nm = "car3" then
    -- three counters: [Bm Bm 5] -> [0 0 6] (carry into the suffix row, then an overflow without a new limb),
    -- [Bm 3 5] -> [0 4 5] (carry into the suffix row, stop there), [Bm Bm Bm 7] -> [0 0 0 8] (two links)
    some (nC (nA (ofLimbs [Bm, Bm, 5])) (nC (nA (ofLimbs [Bm, 3, 5])) (nA (ofLimbs [Bm, Bm, Bm, 7]))),
      nC (op3 (op4 (ax 2))) (nC (op3 (op4 (ax 6))) (op3 (op4 (ax 7)))),
      "*[[[Bm Bm 5] [Bm 3 5] [Bm Bm Bm 7]] [[3 [4 [0 2]]] [3 [4 [0 6]]] [3 [4 [0 7]]]]] (carries into suffix rows)")
  else if nm = "ne7" then
    -- op 5 on big atoms whose first difference is deeper than axis 2: [5 7 9] vs [5 8 9] (axis 6), [5 7 9] vs
    -- [5 7 10] (axis 7), [5 Bm] vs [5 0 1] (axis 3: an inline limb vs a suffix row), and [5 7 9] = [5 7 9]
    let a := nA (ofLimbs [5, 7, 9])
    some (nC (nC a (nA (ofLimbs [5, 8, 9]))) (nC (nC a (nA (ofLimbs [5, 7, 10])))
        (nC (nA (ofLimbs [5, Bm])) (nA (ofLimbs [5, 0, 1])))),
      nC (op5 (ax 4) (ax 5)) (nC (op5 (ax 12) (ax 13)) (nC (op5 (ax 14) (ax 15)) (op5 (ax 4) (ax 12)))),
      "*[[[a [5 8 9]] [a [5 7 10]] [[5 Bm] [5 0 1]]] [5 4 5] [5 12 13] [5 14 15] [5 4 12]] a = [5 7 9] (deep first differences)")
  else if nm = "shs" then
    -- SHARED SUFFIX: p = [1 Bm] is a big atom of the subject AND the new suffix of [Bm 0 Bm] + 1 = [0 1 Bm]
    some (nC (nA P) (nA (ofLimbs [Bm, 0, Bm])), op3 (op4 (ax 3)),
      "*[[p [Bm 0 Bm]] [3 [4 [0 3]]]] (the new suffix [1 Bm] is the row of the earlier atom p)")
  else if nm = "shs2" then

    some (nC (nA (ofLimbs [5, 3, 4])) (nA (ofLimbs [Bm, Bm, 2, 4])), op3 (op4 (ax 3)),
      "*[[[5 3 4] [Bm Bm 2 4]] [3 [4 [0 3]]]] (the new suffix [3 4] is a suffix of the earlier [5 3 4])")
  else if nm = "shc" then
    -- SHARED SUFFIX + CONVERSION: p - 1 -> p (a conversion row on [1 Bm]) and [Bm 0 Bm] -> [0 1 Bm] (an inc row
    -- needed on its suffix [1 Bm]): one noun, two creation records
    -- (and op 5 on p vs [0 1 Bm]: the atom walk over both copies' nouns)
    some (nC (nA (P - 1)) (nA (ofLimbs [Bm, 0, Bm])),
      nC (op3 (op4 (ax 2))) (nC (op3 (op4 (ax 3))) (op5 (op4 (ax 2)) (op4 (ax 3)))),
      "*[[p-1 [Bm 0 Bm]] [[3 [4 [0 2]]] [3 [4 [0 3]]] [5 [4 [0 2]] [4 [0 3]]]]] (conversion p, the inc suffix [1 Bm], op 5)")
  else if nm = "shc2" then
    -- as shc, and op 5 on [0 1 Bm] (the inc result, its suffix the LINKED copy of [1 Bm]) vs [0 2 Bm]: first
    -- difference at axis 6, inside the linked copy (the atom walk passes the interior row [1 Bm])
    some (nC (nA (P - 1)) (nC (nA (ofLimbs [Bm, 0, Bm])) (nA (ofLimbs [0, 2, Bm]))),
      nC (op3 (op4 (ax 2))) (op5 (op4 (ax 6)) (ax 7)),
      "*[[p-1 [Bm 0 Bm] [0 2 Bm]] [[3 [4 [0 2]]] [5 [4 [0 6]] [0 7]]]] (op 5 through the linked copy, axis 6)")
  else none

def mlNames : List String := ["ovf", "car3", "ne7", "shs", "shs2", "shc", "shc2"]

/-- The generated input of a named program (`example`, or a demo), at the coins `χ`. -/
def progInput (nm : String) (χ : CoinsE) : Except String (String × InJ8) := do
  if nm = "mat" then
    -- the jetted matmul n = 2 (`GenXDemo.matProg`, registry id 7 = the compiled `matmulT 2`; B4759: J present)
    match Nock.V1J8.Gen.genJ8J (fun _ => Nock.Jet.Autogen.matmulT 2) [7] 2 Nock.Jet.Autogen.toyS
        Nock.Edit.GenX.Demo.matProg χ with
    | some I => return ("mat [11 [%wild [1 7]] c_T] (jetted matmul n = 2, J present)", I)
    | none => throw "mat: no run, or out of the generator's scope (big atom)"
  -- Big atoms, generated by `Gen.genJ8A` (atom table + atom walk), subject `p − 1`.
  let pm1 : Nock.Noun := .atom (Nock.Field.p - 1)
  let inc1 : Nock.Noun := .cell (.atom 4) (.cell (.atom 0) (.atom 1))
  let inc2 : Nock.Noun := .cell (.atom 4) inc1
  let bigProg : Option (Nock.Noun × String) :=
    if nm = "cnt" then
      -- *[p-1 [3 [[4 [4 [0 1]]] [1 0]]]]: the counter p-1 -> p -> p+1 (conversion row, then an inc row), the cell
      -- [p+1 0] (a big child: kb = 1, the atom table's mb provide), op 3 on it: result 0 (a small claim)
      some (.cell (.atom 3) (.cell inc2 (.cell (.atom 1) (.atom 0))),
        "*[p-1 [3 [[4 [4 [0 1]]] [1 0]]]] (counter p-1 -> p -> p+1, the big cell [p+1 0], result 0)")
    else if nm = "ne5" then
      -- *[p-1 [5 [4 [0 1]] [4 [4 [0 1]]]]]: op 5 on two DIFFERENT big atoms p, p+1: result 1, atom walk PRESENT
      some (.cell (.atom 5) (.cell inc1 inc2),
        "*[p-1 [5 [4 [0 1]] [4 [4 [0 1]]]]] (op 5: p vs p+1, both big: the atom walk present, result 1)")
    else if nm = "eq5" then
      -- *[p-1 [5 [4 [4 [0 1]]] [4 [4 [0 1]]]]]: op 5 on equal big atoms (handle equality): result 0
      some (.cell (.atom 5) (.cell inc2 inc2), "*[p-1 [5 [4 [4 [0 1]]] [4 [4 [0 1]]]]] (op 5: p+1 = p+1, result 0)")
    else if nm = "rd5" then
      -- *[p-1 [5 [7 [[4 [0 1]] [1 0]] [0 2]] [4 [0 1]]]]: the cell [p 0] (kb child), a path READ of axis 2 ending at
      -- the big child (walk instance 1 with a kind-2 handle), op 5 on p = p: result 0
      some (.cell (.atom 5) (.cell (.cell (.atom 7) (.cell (.cell inc1 (.cell (.atom 1) (.atom 0)))
          (.cell (.atom 0) (.atom 2)))) inc1),
        "*[p-1 [5 [7 [[4 [0 1]] [1 0]] [0 2]] [4 [0 1]]]] (read axis 2 of [p 0], op 5 p = p, result 0)")
    else none
  -- Multi-limb atoms, generated by `Gen.genJ8A` with the big atoms in the SUBJECT (out of the
  -- claim scope `hclA`: judged by `Gen.checkJ8W`, the claim-scope conjuncts waived; see `Nock/V1J8/GenAtomBig.lean`).
  if let some (s, f, txt) := mlProg nm then
    match Nock.V1J8.Gen.genJ8A (fun _ => none) 1000 s f χ with
    | some I => return (s!"{nm} {txt}", I)
    | none => throw s!"{nm}: no run, or a jet call"
  if let some (f, txt) := bigProg then
    match Nock.V1J8.Gen.genJ8A (fun _ => none) 1000 pm1 f χ with
    | some I => return (s!"{nm} {txt}", I)
    | none => throw s!"{nm}: no run, or a jet call"
  let (s, f, txt) ← if nm = "example" then
      pure (Nock.NockVMROM.Thm54.VclL.Handle.InhabJ8Base.s0, Nock.NockVMROM.Thm54.VclL.Handle.InhabJ8Base.f0,
        "*[[0 0] [0 1]]")
    else match (Nock.TraceGenExe.demos.find? fun d => d.1 = nm) with
      | none => throw s!"unknown program {nm}"
      | some (_, st, ft) => do
        let s ← Nock.TraceGenExe.parseNoun st
        let f ← Nock.TraceGenExe.parseNoun ft
        pure (s, f, s!"*[{st} {ft}]")
  match Nock.V1J8.Gen.genJ8 (fun _ => none) 100000 s f χ with
  | none => throw s!"{nm}: no run, or out of the generator's scope (big atom / jet call)"
  | some I => pure (s!"{nm} {txt}", I)

def run (o : Opts) : IO UInt32 := do
  let χ ← match o.coins with
    | none => pure (some (if o.prog.isSome && o.prog != some "example" then Nock.V1J8.Gen.prngCoins 1 else χ0e))
    | some f => do
      match ← (readCoins f).run with
      | .ok c => pure (some c)
      | .error e => IO.eprintln s!"input error: {e}"; pure none
  let some χ := χ | return 2
  let G ← match o.prog with
    | none => pure (some ("J-8 example *[[0 0] [0 1]] = [0 0] (fixed fills)", honest χ))
    | some nm =>
      match progInput nm χ with
      | .ok r => pure (some r)
      | .error e => IO.eprintln s!"input error: {e}"; pure none
  let some (title, H) := G | return 2
  if let some d := o.dump then
    IO.FS.createDirAll d
    for (nm, w) in chips do writeRows (System.FilePath.mk d / nm) (chipOf H nm) w
    IO.println s!"dumped the five chips' rows to {d}"
  let I ← match o.inDir with
    | none => pure (some H)
    | some d => do
      match ← (replace H d).run with
      | .ok I => pure (some I)
      | .error e => IO.eprintln s!"input error: {e}"; pure none
  let some I := I | return 2
  IO.println s!"{title}: rows compute {I.X.n}, cell {I.C.n}, walk {I.W.n}, J {I.J.n}, atom {I.A.n}, atom walk {I.V.n}"
  let t0 ← IO.monoMsNow
  let ml := o.prog.any (mlNames.contains ·)
  let chk : InJ8 → Bool := if ml then Nock.V1J8.Gen.checkJ8W else if o.fast then Nock.V1J8.Check.checkFast else checkJ8
  let ok := chk I
  if ml then IO.print "[scope-waived checkJ8W: claim leaves >= p, NOT the verifier] "
  IO.print (if ok then "ACCEPT" else "REJECT")
  let t1 ← IO.monoMsNow
  IO.println s!"  ({if o.fast then "checkFast" else "checkJ8"} {t1 - t0} ms)"
  for (n, b) in parts I do IO.println s!"  {verdict b}  {n}"
  if ml then
    let bad := (Nock.V1J8.Gen.staticParts I).filter fun x => !x.2.2
    IO.println s!"  static conjuncts failing: {bad.map fun x => (x.1, if x.2.1 then "waived" else "NOT WAIVED")}"
    IO.println s!"  public equations: {Nock.V1J8.Gen.pubParts I}"
    IO.println "  atom rows (idx aL wR aR idR | inc conv c_out idx_o l_o kR_o vR_o mi mb):"
    for i in List.finRange I.A.n do
      IO.println s!"    {[2, 7, 6, 8, 4].map fun c => (I.A.cols c i).val} | {[197, 198, 199, 200, 201, 202, 203, 204, 196].map fun c => (I.A.cols c i).val}"
  if !ok then
    IO.println s!"  public equations: {Nock.V1J8.Gen.pubParts I}"
    let dg := fun (nm : String) (l : List (ℕ × List ℕ)) => do
      if !l.isEmpty then IO.println s!"  {nm} failing source gates (row, gate indices): {l}"
    dg "atom HQL" (Nock.V1J8.Gen.diagM (Nock.NockVMROM.Thm54.VclL.Handle.AtomChipHQL.atomTemplateHQL deltaF) (tabA I) 8)
    dg "cell KW" (Nock.V1J8.Gen.diagM (Nock.NockVMROM.Thm54.VclL.Handle.CellTwinKW.cellTemplateHQKW deltaF) (tabC I) 8)
    if I.krootsV != 0 then
      dg "atom walk" (Nock.V1J8.Gen.diagM (Nock.NockVMROM.Thm54.VclL.Handle.CellTwinK.walkTemplateHQK deltaF I.krootsV)
        (tabV I) 8)
  if !(CompX.checkCompX (tabX I)) then
    let T := tabX I
    let nb := (Nock.NockVMROM.Thm54.VclL.Handle.ChipHX.baseGatesFX (F := ZMod Nock.Field.p)).length
    let ns := (Nock.NockVMROM.Thm54.VclL.Handle.ChipHX.slotPairsX (ZMod Nock.Field.p) Nock.TraceGenExe.deltaF).length
    IO.println s!"  compute diagnosis (source gates: {nb} base, {ns} slot pairs, then walk):"
    let mut shown := 0
    for i in List.finRange I.X.n do
      let bad := (CompX.srcX.zipIdx 0).filter fun (g, _) => !(CompX.srcOK (T.env i) g)
      if !bad.isEmpty && shown < 12 then
        shown := shown + 1
        IO.println s!"    row {i.val} (state cols 0..16 = {(List.range 17).map fun c => (I.X.cols c i).val}): gates {bad.map (·.2)}"
  if o.tamper then
    IO.println "tamper suite (each must be rejected):"
    let ts := match o.prog with
      | none => tampers χ
      | some nm => Nock.V1J8.Gen.tampersOf H ++ (if nm = "mat" then Nock.V1J8.Gen.jTampersOf H else []) ++
          (if nm = "cnt" || nm = "ne5" || nm = "eq5" || nm = "rd5" || mlNames.contains nm then
            Nock.V1J8.Gen.aTampersOf H else []) ++
          (if mlNames.contains nm then Nock.V1J8.Gen.mlTampersOf H else [])
    for (n, T) in ts do
      IO.println s!"  {if chk T then "ACCEPTED (BAD)" else "rejected"}  {n}"
  return (if ok then 0 else 1)

/-! ## D5 sizes report: `nockvm-j8check report [--sweep] [--n N,N,..] [--big]` -/

def fmtNat (n : ℕ) : String :=
  let cs := (toString n).toList.reverse
  let rec go : List Char → ℕ → List Char
    | [], _ => []
    | c :: r, k => (if k > 0 && k % 3 == 0 then [',', c] else [c]) ++ go r (k + 1)
  String.ofList (go cs 0).reverse

open Nock.V1J8.D5 in
def rowsLine (nm : String) (rs : List ℕ) (steps : ℕ) : String :=
  let cm := committed rs
  s!"| {nm} | " ++ " | ".intercalate (rs.map fmtNat) ++ s!" | {fmtNat steps} |"

open Nock.V1J8.D5 in
def committedLine (nm : String) (rs : List ℕ) (steps : ℕ) : String :=
  let cm := committed rs
  let t := total rs
  s!"| {nm} | " ++ " | ".intercalate (cm.map fmtNat) ++ s!" | {fmtNat t} | {fmtNat steps} | " ++
    s!"{if steps = 0 then "-" else toString (t / steps)} |"

open Nock.V1J8.D5 in
/-- One side of a matmul sweep row: (rows, steps, ms, result ok). -/
def measure (gen : InJ8 → Option (List ℕ × ℕ)) (g : Option InJ8) : Option (List ℕ × ℕ) := g.bind gen

open Nock.V1J8.D5 in
def reportMat (ns : List ℕ) (full : Bool) (jetOnly : Bool := false) : IO Unit := do
  let χ := Nock.V1J8.Gen.prngCoins 1
  let mut sizeRows : List String := []
  let mut comRows : List String := []
  let mut ratio : List String := []
  for N in ns do
    IO.println s!"-- N = {N}: formula cells {cellsOf (matPure N)}, subject cells {cellsOf (matS N)}"
    (← IO.getStdout).flush
    let mut res : List (String × Option (List ℕ × ℕ)) := []
    for (nm, jet) in (if jetOnly then [("jetted", true)] else [("pure", false), ("jetted", true)]) do
      let t0 ← IO.monoMsNow
      let r := if jet then fastJet N else fastPure N
      match r with
      | none => IO.println s!"   {nm}: none (no run / scope)"; res := res ++ [(nm, none)]
      | some (rs, st) =>
        let t1 ← IO.monoMsNow
        let rr := if jet then runJet N else runPure N
        IO.println s!"   {nm}: rows {rs} steps {st} count stage {t1 - t0} ms, runX result = reference: {rr.map (·.2 == matRef N)}"
        (← IO.getStdout).flush
        res := res ++ [(nm, some (rs, st))]
        if full then
          let g := if jet then genJet N χ else genPure N χ
          match g with
          | none => IO.println "   full generator: none"
          | some I =>
            IO.println s!"   full generator: rows {rowsOf I} (= count stage: {rowsOf I == rs}) result = reference: {I.c.result == matRef N} {(← IO.monoMsNow) - t1} ms"
          (← IO.getStdout).flush
    for (nm, r) in res do
      if let some (rs, st) := r then
        sizeRows := sizeRows ++ [rowsLine s!"{nm} N={N}" rs st]
        comRows := comRows ++ [committedLine s!"{nm} N={N}" rs st]
    match res with
    | [(_, some (rp, sp)), (_, some (rj, sj))] =>
      ratio := ratio ++ [s!"| N={N} | {fmtNat sp} | {fmtNat sj} | {fmtNat (total rp)} | {fmtNat (total rj)} | " ++
        s!"{(total rp) / (max 1 (total rj))}x |"]
    | _ => pure ()
  IO.println "\n### Rows per table\n"
  IO.println ("| program | " ++ " | ".intercalate tableNames ++ " | Nock steps |")
  IO.println ("|---|" ++ String.join (tableNames.map fun _ => "---|") ++ "---|")
  for l in sizeRows do IO.println l
  IO.println "\n### Committed field elements (rows x width; widths 123 / 242 / 166 / 71 / 349 / 166)\n"
  IO.println ("| program | " ++ " | ".intercalate tableNames ++ " | total | Nock steps | elements / step |")
  IO.println ("|---|" ++ String.join (tableNames.map fun _ => "---|") ++ "---|---|---|")
  for l in comRows do IO.println l
  IO.println "\n### Pure vs jetted\n"
  IO.println "| N | steps pure | steps jetted | committed pure | committed jetted | pure / jetted |"
  IO.println "|---|---|---|---|---|---|"
  for l in ratio do IO.println l

def bigNames : List String := ["cnt", "ne5", "eq5", "rd5", "ovf", "car3", "ne7"]

open Nock.V1J8.D5 in
def reportBig (nms : List String) : IO Unit := do
  let χ := Nock.V1J8.Gen.prngCoins 1
  let mut sizeRows : List String := []
  let mut comRows : List String := []
  for nm in nms do
    match progInput nm χ with
    | .error e => IO.println s!"{nm}: {e}"
    | .ok (title, I) =>
      let rs := rowsOf I
      IO.println s!"{title}: rows {rs}"
      (← IO.getStdout).flush
      sizeRows := sizeRows ++ [rowsLine nm rs I.X.n]
      comRows := comRows ++ [committedLine nm rs I.X.n]
  IO.println "\n### Rows per table\n"
  IO.println ("| program | " ++ " | ".intercalate tableNames ++ " | Nock steps |")
  IO.println ("|---|" ++ String.join (tableNames.map fun _ => "---|") ++ "---|")
  for l in sizeRows do IO.println l
  IO.println "\n### Committed field elements\n"
  IO.println ("| program | " ++ " | ".intercalate tableNames ++ " | total | Nock steps | elements / step |")
  IO.println ("|---|" ++ String.join (tableNames.map fun _ => "---|") ++ "---|---|---|")
  for l in comRows do IO.println l
/-- **Backend.** The Fiat-Shamir driver's backend for a named program. -/
def backendOf (nm : String) : Nock.DriverJ8.DriverJ8.Backend :=
  let ml := mlNames.contains nm
  { gen := fun χ => (progInput nm χ).map (·.2)
    check := if ml then Nock.V1J8.Gen.checkJ8W else checkJ8
    ph := Nock.V1J8.Gen.prngCoins 1 }

def driveMain (args : List String) : IO UInt32 := do
  let rec go : List String → List (String × String) → Option (List (String × String))
    | [], m => some m
    | k :: v :: r, m => if k.startsWith "--" then go r ((k, v) :: m) else none
    | _, _ => none
  match go args [] with
  | none => IO.eprintln "usage: drive --prog NAME [--mode fs|interactive] --out DIR"; return 2
  | some m =>
    let prog := (m.lookup "--prog").getD "example"
    let some mode := Nock.DriverJ8.DriverJ8.Mode.parse? ((m.lookup "--mode").getD "fs")
      | IO.eprintln "mode must be fs or interactive"; return 2
    let some out := m.lookup "--out" | IO.eprintln "need --out DIR"; return 2
    try
      let r ← Nock.DriverJ8.DriverJ8.drive (backendOf prog) mode (System.FilePath.mk out) prog
      IO.println s!"events: {r.log}"
      IO.println s!"{prog} [{(m.lookup "--mode").getD "fs"}]: {if r.accepted then "ACCEPT" else "REJECT"}"
      return (if r.accepted then (0 : UInt32) else 1)
    catch e => IO.eprintln s!"error: {e}"; return 2

def verifyMain (args : List String) : IO UInt32 := do
  match args with
  | ["--prog", prog, "--dir", dir] =>
    try
      let r ← Nock.DriverJ8.DriverJ8.verify (backendOf prog) (System.FilePath.mk dir)
      for l in r.log do IO.println s!"  {l}"
      IO.println s!"{prog} [verify]: {if r.accepted then "ACCEPT" else "REJECT"}"
      return (if r.accepted then (0 : UInt32) else 1)
    catch e => IO.eprintln s!"error: {e}"; return 2
  | _ => IO.eprintln "usage: verify --prog NAME --dir DIR"; return 2

end Nock.V1J8.J8CheckMain

open Nock.V1J8.J8CheckMain in
def main (args : List String) : IO UInt32 := do
  match args with
  | "check" :: rest =>
    match parseOpts rest {} with
    | .error e => IO.eprintln e; return 2
    | .ok o => run o
  | "report" :: rest =>
    let fullRef ← IO.mkRef false
    let stepsRef ← IO.mkRef false
    let jetRef ← IO.mkRef false
    let rec go : List String → List ℕ → Bool → IO UInt32
      | [], ns, big => do
        if ← stepsRef.get then
          for N in ns do
            let t0 ← IO.monoMsNow
            let rp := Nock.V1J8.D5.runPure N
            IO.println s!"N={N} pure runX: {rp.map (·.1)} steps, result = reference {rp.map (·.2 == Nock.V1J8.D5.matRef N)} ({(← IO.monoMsNow) - t0} ms; compute rows only, other tables NOT counted); jetted: {(Nock.V1J8.D5.runJet N).map (·.1)} steps"
            (← IO.getStdout).flush
        else if big then reportBig bigNames
        else reportMat (if ns.isEmpty then [2, 4, 8, 16] else ns) (← fullRef.get) (← jetRef.get)
        return 0
      | "--sweep" :: r, ns, b => go r ns b
      | "--steps" :: r, ns, b => do stepsRef.set true; go r ns b
      | "--jet-only" :: r, ns, b => do jetRef.set true; go r ns b
      | "--check" :: r, ns, b => do fullRef.set true; go r ns b
      | "--big" :: r, ns, _ => go r ns true
      | "--n" :: v :: r, ns, b => go r (ns ++ (v.splitOn ",").filterMap String.toNat?) b
      | a :: _, _, _ => do IO.eprintln s!"report: unknown argument {a}"; return 2
    go rest [] false
  | "drive" :: rest => driveMain rest
  | "verify" :: rest => verifyMain rest
  | _ => IO.eprintln "usage: nockvm-j8check check [--prog NAME] [--coins FILE] [--in DIR] [--dump DIR] [--tamper] [--fast] | drive --prog NAME [--mode fs|interactive] --out DIR | verify --prog NAME --dir DIR | report [--sweep] [--n N,N] [--big]"; return 2
